{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "collection.ts",
        "config/index.ts",
        "config/vars.ts",
        "connector.ts",
        "domain.ts",
        "forumCategory.ts",
        "getOrg.ts",
        "getSpace.ts",
        "getSpaceTypes.ts",
        "getStatusPage.ts",
        "index.ts",
        "orgSetting.ts",
        "page.ts",
        "provider.ts",
        "serviceConnector.ts",
        "site.ts",
        "siteManifest.ts",
        "space.ts",
        "spaceLocale.ts",
        "spaceSettings.ts",
        "statusComponent.ts",
        "statusGroups.ts",
        "statusIncidentTemplate.ts",
        "statusMetric.ts",
        "translationOverride.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts",
        "webhook.ts"
    ]
}
